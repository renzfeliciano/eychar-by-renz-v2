# MongoDB Atlas connection string. Use a database dedicated to this project —
# do NOT point this at PCAS-WorkforceHub's cluster/database.
MONGODB_URI=

# Auth.js
NEXTAUTH_URL=http://localhost:4100
NEXTAUTH_SECRET=

# Minutes of inactivity before a session is force-expired (idle timeout —
# see src/server/auth/session-policy.ts). Defaults to 30 if unset.
SESSION_INACTIVITY_MINUTES=30

# Encrypts two-step verification secrets at rest (AES-256-GCM). 32 random
# bytes, base64 — e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`.
# Optional in development (derived from NEXTAUTH_SECRET when unset); set it in
# production. Changing it invalidates everyone's two-step setup.
MFA_ENCRYPTION_KEY=

# Bearer secret for /api/cron/payroll-schedules (daily payroll draft preparation).
CRON_SECRET=

# Seed script (Phase 1 bootstrap: 1 Organization + 1 HR user).
# The organization is a plain, editable data record — this just sets its
# initial value.
SEED_ORGANIZATION_NAME=
SEED_ORGANIZATION_SLUG=
SEED_HR_FULL_NAME=
SEED_HR_USERNAME=
SEED_HR_PASSWORD=
