# MongoDB Atlas connection string. Use a database dedicated to this project —
# do NOT point this at PCAS-WorkforceHub's cluster/database.
MONGODB_URI=

# Auth.js
NEXTAUTH_URL=http://localhost:4100
NEXTAUTH_SECRET=

# Seed script (Phase 1 bootstrap: 1 Organization + 1 HR user).
# The organization is a plain, editable data record — this just sets its
# initial value.
SEED_ORGANIZATION_NAME=
SEED_ORGANIZATION_SLUG=
SEED_HR_FULL_NAME=
SEED_HR_USERNAME=
SEED_HR_PASSWORD=
